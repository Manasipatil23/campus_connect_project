MONGO_URL=mongodb://localhost:27017
DB_NAME=campus_connect
# Use a long random string in any shared or deployed environment
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# Optional: enables Claude resume reviews (otherwise rule-based feedback is used)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_ENABLED=auto

# Verification emails (leave SMTP_HOST empty for dev mode: codes shown on screen)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus Connect <no-reply@yourdomain.com>
CHECK_EMAIL_DELIVERABILITY=true

# Website address used in email links
APP_URL=http://localhost:5173

# Platform admin: only these addresses can be admin (comma-separated).
# The admin sets their password from the sign-in page with an emailed code.
ADMIN_EMAILS=
